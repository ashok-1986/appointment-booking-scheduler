# ==============================================================================
# Environment Configuration: Artist Appointment Booking & Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:4000"
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
CRON_SECRET="your-secure-cron-secret-token"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/artist_booking"

# ------------------------------------------------------------------------------
# 3. HubSpot CRM API
# ------------------------------------------------------------------------------
# Create a Private App in HubSpot Settings -> Integrations -> Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.deals.read, crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN="pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. Razorpay Payments
# ------------------------------------------------------------------------------
# From Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_custom_webhook_secret_for_verification"

# ------------------------------------------------------------------------------
# 5. WhatsApp Business Cloud API (Meta)
# ------------------------------------------------------------------------------
# From Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="your_custom_verify_token_for_webhook"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_webhook_signature"

# ------------------------------------------------------------------------------
# 6. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# From Resend Dashboard -> API Keys & Domains
RESEND_API_KEY="re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Artist Studio <bookings@yourdomain.com>"

# ------------------------------------------------------------------------------
# 7. Google Calendar API (OAuth 2.0)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REFRESH_TOKEN="1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_CALENDAR_ID="primary"
